# ==============================================================================
# PocketFleet 三席位战队环境配置示例 (.env.example)
# 使用方式：复制本件为 .env，填入对应的真实 Token 或配置；.env 严格受 .gitignore 保护，严禁提交。
# ==============================================================================

# ------------------------------------------------------------------------------
# 席位 1：对话 AI (Chat) —— 默认席位：地球Sandbox (Gemini)
# 职责：负责全局对话、推演对账与宏观思考
# ------------------------------------------------------------------------------
# 对话 AI 专属 Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_SANDBOX_TOKEN=

# ------------------------------------------------------------------------------
# 席位 2：施工指挥 / 验收官 (Lead) —— 默认席位：裁决者 (Antigravity)
# 职责：负责立项出题、定义严苛验收军令状、工程打包与沙箱改卷验收
# ------------------------------------------------------------------------------
# 施工指挥专属 Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_JUDGE_TOKEN=

# Antigravity 官方 CLI 路径。已加入 PATH 时保持 agy 即可，也可填写完整绝对路径
POCKETFLEET_ANTIGRAVITY_CLI=agy

# ------------------------------------------------------------------------------
# 席位 3：主力程序员 (Builder) —— 默认席位：泥蛇 (Codex)
# 职责：负责核心代码攻坚、算法逆向解题与生产就绪级代码落盘
# ------------------------------------------------------------------------------
# 主力程序员专属 Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_MUDSNAKE_TOKEN=

# Codex CLI 或 VS Code app-server 启动命令/路径。已加入 PATH 保持 codex 即可
POCKETFLEET_CODEX_BIN=codex

# ------------------------------------------------------------------------------
# 战役室全局安全锁 (Commander Security Whitelist)
# ------------------------------------------------------------------------------
# 授权人类指挥官 Telegram User ID，多个 ID 用英文逗号分隔
POCKETFLEET_AUTHORIZED_USER_IDS=6801810539
