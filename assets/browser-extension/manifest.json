{
  "manifest_version": 3,
  "name": "Folded Host Local Bridge",
  "version": "0.6.43",
  "description": "Local CodeAi bridge for designated ChatGPT, Qwen, Doubao, Gemini, Copilot, and DeepSeek browser agents.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.qwen.ai/*",
    "https://www.doubao.com/*",
    "https://chatglm.cn/*",
    "https://gemini.google.com/*",
    "https://copilot.com/*",
    "https://*.copilot.com/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.kimi.com/*",
    "http://127.0.0.1:18765/*",
    "http://127.0.0.1:18766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.qwen.ai/*",
        "https://www.doubao.com/*",
        "https://chatglm.cn/*",
        "https://gemini.google.com/*",
        "https://copilot.com/*",
        "https://*.copilot.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*"
      ],
      "js": [
        "adapter_profiles.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/robot-16.png",
    "32": "icons/robot-32.png",
    "48": "icons/robot-48.png",
    "128": "icons/robot-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Folded Host Local Bridge",
    "default_icon": {
      "16": "icons/robot-16.png",
      "32": "icons/robot-32.png"
    }
  }
}
